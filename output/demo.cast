{"version": 2, "width": 72, "height": 22, "timestamp": 1794561947, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.006574, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.007043, "o", "\r\n  +------------------------------------------------------------------+\r\n  |  SEGMENT 1/5  BUILD: library + repo example entry point            |\r\n  +------------------------------------------------------------------+\r\n\r\n"]
[3.009242, "o", "$ cmake --build build --target opusfile_example\r\n"]
[3.082129, "o", "[ 80%] Built target opusurl\r\n[100%] Built target opusfile_example\r\n"]
[3.082553, "o", "\r\n"]
[3.084516, "o", "Usage: /home/gyr/feedback/uid5248/build/opusfile_example [--no-gain] [--gain-offset=<q8>] <file.opus>\r\n"]
[5.588316, "o", "\u001b[H\u001b[2J\u001b[3J"]
[5.588496, "o", "\r\n  +------------------------------------------------------------------+\r\n  |  SEGMENT 2/5  MATERIAL: same take, loudness differs by 20 dB       |\r\n  +------------------------------------------------------------------+\r\n\r\n"]
[8.59402, "o", "gain_m6.opus\r\ngain_p14.opus\r\ngain_p4.opus\r\n"]
[8.594332, "o", "\r\nheader gains: -6 dB / +4 dB / +14 dB (patched into OpusHead output_gain)\r\n"]
[11.098227, "o", "\u001b[H\u001b[2J\u001b[3J"]
[11.098347, "o", "\r\n  +------------------------------------------------------------------+\r\n"]
[11.098408, "o", "  |  SEGMENT 3/5  GAIN ON: playback energies align                     |\r\n  +------------------------------------------------------------------+\r\n\r\n"]
[14.129436, "o", "  gain_m6      RMS = -19.019 dBFS   (Effective gain: -6.00 dB)\r\n"]
[14.155252, "o", "  gain_p4      RMS = -19.013 dBFS   (Effective gain: 4.00 dB)\r\n"]
[14.17942, "o", "  gain_p14     RMS = -19.008 dBFS   (Effective gain: 14.00 dB)\r\n\r\n  -> spread < 0.02 dB: loudness unified by the header gains\r\n"]
[16.682906, "o", "\u001b[H\u001b[2J\u001b[3J"]
[16.683144, "o", "\r\n  +------------------------------------------------------------------+\r\n  |  SEGMENT 4/5  GAIN OFF: bypass gain, samples bit-identical         |\r\n  +------------------------------------------------------------------+\r\n\r\n"]
[19.709564, "o", "  gain_m6      RMS = -13.019 dBFS (gain disabled)\r\n"]
[19.735842, "o", "  gain_p4      RMS = -23.013 dBFS (gain disabled)\r\n"]
[19.759276, "o", "  gain_p14     RMS = -33.008 dBFS (gain disabled)\r\n\r\n$ opusfile_example --no-gain gain_p4.opus > off_p4.wav\r\n"]
[19.759441, "o", "$ opusfile_example gain_0.opus        > on_g0.wav   # header gain = 0\r\n"]
[19.776854, "o", "$ cmp off_p4.wav on_g0.wav\r\n"]
[19.778024, "o", "  -> zero differences: switch-off is sample-exact\r\n"]
[22.282039, "o", "\u001b[H\u001b[2J\u001b[3J"]
[22.282242, "o", "\r\n  +------------------------------------------------------------------+\r\n  |  SEGMENT 5/5  CLAMP: out-of-range gain is clamped and reported     |\r\n  +------------------------------------------------------------------+\r\n\r\n"]
[25.28497, "o", "$ opusfile_example --gain-offset=98303 gain_p4.opus\r\n"]
[25.28706, "o", "Gain application: enabled\r\nEffective gain: 128.00 dB (requested gain was out of range; clamped to [-128,128) dB)\r\n"]
[25.293093, "o", "\r\n$ opusfile_example --gain-offset=-98302 gain_p4.opus\r\n"]
[25.294966, "o", "Effective gain: -128.00 dB (requested gain was out of range; clamped to [-128,128) dB)\r\n"]
[25.300815, "o", "\r\n$ opusfile_example --gain-offset=2560 gain_p4.opus   # in range: no clamp flag\r\n"]
[25.302456, "o", "Effective gain: 10.00 dB\r\n"]
[25.308362, "o", "\r\nGain is applied by the decoder (OPUS_SET_GAIN) while filling the output\r\nbuffer: no second full copy of the decoded samples.\r\n"]
[29.311765, "o", "\u001b[H\u001b[2J\u001b[3J"]
[29.31198, "o", "  Demo complete. Artifacts in output/.\r\n"]
